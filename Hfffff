<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>PrimeFit Quotation</title>

<style>
*{
    box-sizing:border-box;
}

body{
    margin:0;
    font-family:Arial,Helvetica,sans-serif;
    background:#eef2f1;
    color:#222;
}

/* =========================================================
   BUILDER
   ========================================================= */

#builderScreen{
    display:block;
    min-height:100vh;
}

.builder-header{
    background:#12372f;
    color:white;
    padding:20px 16px;
}

.builder-header h1{
    margin:0;
    font-size:25px;
}

.builder-header p{
    margin:6px 0 0;
    opacity:.85;
    font-size:14px;
}

.builder{
    max-width:1000px;
    margin:auto;
    padding:16px;
}

.card{
    background:white;
    border-radius:12px;
    padding:18px;
    margin-bottom:16px;
    box-shadow:0 2px 8px rgba(0,0,0,.08);
}

.card h2{
    margin:0 0 15px;
    font-size:19px;
    color:#12372f;
}

.grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:12px;
}

.field{
    display:flex;
    flex-direction:column;
}

.field.full{
    grid-column:1/-1;
}

label{
    font-size:13px;
    font-weight:bold;
    margin-bottom:5px;
}

input,
select,
textarea{
    width:100%;
    padding:11px;
    border:1px solid #cfd6d3;
    border-radius:7px;
    font-size:15px;
    background:white;
}

textarea{
    min-height:80px;
    resize:vertical;
}

.material-table{
    width:100%;
    border-collapse:collapse;
}

.material-table th,
.material-table td{
    border-bottom:1px solid #ddd;
    padding:8px 5px;
    text-align:left;
    font-size:13px;
}

.material-table th{
    background:#f1f5f3;
}

.material-table input{
    padding:8px;
    font-size:13px;
}

.remove-btn{
    border:0;
    background:#b3261e;
    color:white;
    border-radius:5px;
    padding:7px 9px;
    cursor:pointer;
}

.add-btn{
    margin-top:12px;
    border:1px solid #12372f;
    background:white;
    color:#12372f;
    padding:10px 14px;
    border-radius:7px;
    font-weight:bold;
    cursor:pointer;
}

.total-box{
    background:#f1f6f4;
    border-radius:10px;
    padding:15px;
}

.total-row{
    display:flex;
    justify-content:space-between;
    padding:7px 0;
}

.grand-total{
    border-top:2px solid #12372f;
    margin-top:8px;
    padding-top:12px;
    font-size:21px;
    font-weight:bold;
    color:#12372f;
}

.generate-area{
    text-align:center;
    padding:10px 0 30px;
}

.generate-btn{
    width:100%;
    max-width:500px;
    border:0;
    background:#12372f;
    color:white;
    padding:16px;
    border-radius:9px;
    font-size:17px;
    font-weight:bold;
    cursor:pointer;
}

.generate-btn:active{
    transform:scale(.99);
}

/* =========================================================
   QUOTATION SCREEN
   ========================================================= */

#quotationScreen{
    display:none;
    min-height:100vh;
    background:#ddd;
}

.quote-toolbar{
    position:sticky;
    top:0;
    z-index:20;
    background:#12372f;
    padding:10px;
    display:flex;
    gap:8px;
    flex-wrap:wrap;
    justify-content:center;
}

.quote-toolbar button{
    border:0;
    border-radius:6px;
    padding:10px 13px;
    font-weight:bold;
    cursor:pointer;
}

.pdf-btn{
    background:#fff;
    color:#12372f;
}

.edit-btn{
    background:#dbe8e4;
    color:#12372f;
}

.new-btn{
    background:#b3261e;
    color:white;
}

.quote-wrapper{
    padding:25px 10px;
}

.quotation-page{
    background:white;
    width:210mm;
    min-height:297mm;
    margin:0 auto;
    padding:16mm;
    box-shadow:0 2px 15px rgba(0,0,0,.2);
    position:relative;
}

.quote-top{
    display:flex;
    justify-content:space-between;
    gap:20px;
    border-bottom:3px solid #12372f;
    padding-bottom:15px;
}

.company-name{
    font-size:28px;
    font-weight:bold;
    color:#12372f;
}

.company-subtitle{
    margin-top:5px;
    font-size:13px;
    color:#555;
}

.quote-title{
    text-align:right;
}

.quote-title h1{
    margin:0;
    color:#12372f;
    font-size:25px;
}

.quote-title p{
    margin:5px 0 0;
    font-size:12px;
}

.info-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
    margin:20px 0;
}

.info-box{
    border:1px solid #ddd;
    border-radius:6px;
    padding:12px;
}

.info-box h3{
    margin:0 0 8px;
    color:#12372f;
    font-size:14px;
}

.info-box p{
    margin:4px 0;
    font-size:12px;
}

.quote-table{
    width:100%;
    border-collapse:collapse;
    margin-top:15px;
}

.quote-table th{
    background:#12372f;
    color:white;
    padding:9px 7px;
    font-size:11px;
    text-align:left;
}

.quote-table td{
    padding:8px 7px;
    border-bottom:1px solid #ddd;
    font-size:11px;
}

.quote-table .number{
    text-align:right;
}

.summary{
    width:330px;
    max-width:100%;
    margin:20px 0 0 auto;
}

.summary-row{
    display:flex;
    justify-content:space-between;
    padding:7px 0;
    font-size:12px;
}

.summary-total{
    border-top:2px solid #12372f;
    margin-top:5px;
    padding-top:10px;
    font-size:17px;
    font-weight:bold;
    color:#12372f;
}

.validity{
    margin-top:20px;
    padding:11px;
    background:#f1f5f3;
    border-radius:5px;
    font-size:11px;
}

.notes{
    margin-top:20px;
    font-size:11px;
}

.signature-area{
    margin-top:45px;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:60px;
}

.signature{
    border-top:1px solid #333;
    padding-top:7px;
    font-size:11px;
}

.footer{
    position:absolute;
    bottom:12mm;
    left:16mm;
    right:16mm;
    border-top:1px solid #ddd;
    padding-top:7px;
    text-align:center;
    font-size:9px;
    color:#777;
}

/* =========================================================
   PRINT
   ========================================================= */

@media print{

    @page{
        size:A4;
        margin:0;
    }

    html,
    body{
        margin:0;
        padding:0;
        background:white;
    }

    body *{
        visibility:hidden !important;
    }

    #quotationScreen,
    #quotationScreen *{
        visibility:visible !important;
    }

    .quote-toolbar{
        display:none !important;
    }

    #quotationScreen{
        display:block !important;
        background:white;
        min-height:0;
    }

    .quote-wrapper{
        padding:0;
        margin:0;
    }

    .quotation-page{
        width:210mm;
        min-height:297mm;
        margin:0;
        padding:16mm;
        box-shadow:none;
    }
}

/* =========================================================
   PHONE
   ========================================================= */

@media(max-width:700px){

    .grid{
        grid-template-columns:1fr;
    }

    .field.full{
        grid-column:auto;
    }

    .material-table{
        min-width:650px;
    }

    .material-scroll{
        overflow-x:auto;
    }

    .quotation-page{
        width:100%;
        min-height:auto;
        padding:18px;
    }

    .quote-top{
        flex-direction:column;
    }

    .quote-title{
        text-align:left;
    }

    .info-grid{
        grid-template-columns:1fr;
    }

    .signature-area{
        grid-template-columns:1fr;
        gap:35px;
    }

    .footer{
        position:static;
        margin-top:50px;
    }

    .quote-wrapper{
        padding:10px;
    }
}
</style>
</head>

<body>

<!-- =======================================================
     SCREEN 1: QUOTATION BUILDER
     ======================================================= -->

<section id="builderScreen">

    <header class="builder-header">
        <h1>PrimeFit Quotation</h1>
        <p>Create a professional quotation</p>
    </header>

    <main class="builder">

        <!-- CUSTOMER -->
        <section class="card">

            <h2>Customer Information</h2>

            <div class="grid">

                <div class="field">
                    <label>Customer Name *</label>
                    <input id="customerName" type="text" placeholder="Customer name">
                </div>

                <div class="field">
                    <label>Phone</label>
                    <input id="customerPhone" type="tel" placeholder="Phone number">
                </div>

                <div class="field">
                    <label>Email</label>
                    <input id="customerEmail" type="email" placeholder="Email address">
                </div>

                <div class="field">
                    <label>KRA PIN</label>
                    <input id="customerKra" type="text" placeholder="KRA PIN">
                </div>

                <div class="field full">
                    <label>Customer Address</label>
                    <textarea id="customerAddress" placeholder="Address"></textarea>
                </div>

            </div>

        </section>


        <!-- PROJECT -->
        <section class="card">

            <h2>Project Information</h2>

            <div class="grid">

                <div class="field">
                    <label>Project Name</label>
                    <input id="projectName" type="text" placeholder="e.g. Master Bedroom Wardrobe">
                </div>

                <div class="field">
                    <label>Job Type</label>
                    <select id="jobType">
                        <option>Wardrobe</option>
                        <option>Kitchen Cabinets</option>
                        <option>TV Unit</option>
                        <option>Office Furniture</option>
                        <option>Bedroom Furniture</option>
                        <option>Custom Furniture</option>
                        <option>Interior Design</option>
                    </select>
                </div>

                <div class="field">
                    <label>Width (mm)</label>
                    <input id="width" type="number" value="3000">
                </div>

                <div class="field">
                    <label>Height (mm)</label>
                    <input id="height" type="number" value="2400">
                </div>

                <div class="field">
                    <label>Depth (mm)</label>
                    <input id="depth" type="number" value="600">
                </div>

                <div class="field">
                    <label>Number of Doors</label>
                    <input id="doors" type="number" value="4">
                </div>

                <div class="field">
                    <label>Number of Drawers</label>
                    <input id="drawers" type="number" value="0">
                </div>

                <div class="field">
                    <label>Board Material</label>
                    <select id="board">
                        <option value="MDF">18mm MDF</option>
                        <option value="Plywood">18mm Plywood</option>
                        <option value="Timber">Timber</option>
                    </select>
                </div>

                <div class="field">
                    <label>Finish</label>
                    <input id="finish" type="text" placeholder="e.g. Matte white">
                </div>

            </div>

        </section>


        <!-- MATERIALS -->
        <section class="card">

            <h2>Materials</h2>

            <div class="material-scroll">

                <table class="material-table">

                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Qty</th>
                            <th>Unit</th>
                            <th>Unit Price (KES)</th>
                            <th>Total (KES)</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody id="materialsBody"></tbody>

                </table>

            </div>

            <button class="add-btn" onclick="addMaterial()">
                + Add Material
            </button>

        </section>


        <!-- COSTS -->
        <section class="card">

            <h2>Other Costs</h2>

            <div class="grid">

                <div class="field">
                    <label>Labour (KES)</label>
                    <input id="labour" type="number" value="0">
                </div>

                <div class="field">
                    <label>Transport (KES)</label>
                    <input id="transport" type="number" value="0">
                </div>

                <div class="field">
                    <label>Other Costs (KES)</label>
                    <input id="otherCost" type="number" value="0">
                </div>

                <div class="field">
                    <label>Discount (KES)</label>
                    <input id="discount" type="number" value="0">
                </div>

                <div class="field">
                    <label>VAT (%)</label>
                    <input id="vat" type="number" value="0">
                </div>

                <div class="field">
                    <label>Quotation Valid For (Days)</label>
                    <input id="validDays" type="number" value="30">
                </div>

            </div>

        </section>


        <!-- TOTAL -->
        <section class="card">

            <h2>Quotation Total</h2>

            <div class="total-box">

                <div class="total-row">
                    <span>Materials</span>
                    <strong id="previewMaterials">KES 0.00</strong>
                </div>

                <div class="total-row">
                    <span>Labour</span>
                    <strong id="previewLabour">KES 0.00</strong>
                </div>

                <div class="total-row">
                    <span>Transport</span>
                    <strong id="previewTransport">KES 0.00</strong>
                </div>

                <div class="total-row">
                    <span>Other Costs</span>
                    <strong id="previewOther">KES 0.00</strong>
                </div>

                <div class="total-row">
                    <span>Discount</span>
                    <strong id="previewDiscount">KES 0.00</strong>
                </div>

                <div class="total-row">
                    <span>VAT</span>
                    <strong id="previewVat">KES 0.00</strong>
                </div>

                <div class="total-row grand-total">
                    <span>GRAND TOTAL</span>
                    <strong id="previewGrand">KES 0.00</strong>
                </div>

            </div>

        </section>


        <div class="generate-area">

            <button class="generate-btn" onclick="generateQuotation()">
                GENERATE QUOTATION
            </button>

        </div>

    </main>

</section>


<!-- =======================================================
     SCREEN 2: QUOTATION ONLY
     ======================================================= -->

<section id="quotationScreen">

    <div class="quote-toolbar">

        <button class="pdf-btn" onclick="savePDF()">
            SAVE AS PDF
        </button>

        <button class="edit-btn" onclick="editQuotation()">
            EDIT QUOTATION
        </button>

        <button class="new-btn" onclick="newQuotation()">
            NEW QUOTATION
        </button>

    </div>

    <div class="quote-wrapper">

        <article class="quotation-page" id="quotationPage">

            <div class="quote-top">

                <div>
                    <div class="company-name">
                        PRIME FIT INTERIORS
                    </div>

                    <div class="company-subtitle">
                        Interior Design & Furniture Solutions
                    </div>
                </div>

                <div class="quote-title">

                    <h1>QUOTATION</h1>

                    <p>
                        Quotation No:
                        <strong id="qNumber"></strong>
                    </p>

                    <p>
                        Date:
                        <strong id="qDate"></strong>
                    </p>

                </div>

            </div>


            <div class="info-grid">

                <div class="info-box">

                    <h3>CLIENT</h3>

                    <p>
                        <strong id="qCustomerName"></strong>
                    </p>

                    <p id="qCustomerPhone"></p>

                    <p id="qCustomerEmail"></p>

                    <p id="qCustomerKra"></p>

                    <p id="qCustomerAddress"></p>

                </div>


                <div class="info-box">

                    <h3>PROJECT</h3>

                    <p>
                        <strong id="qProjectName"></strong>
                    </p>

                    <p>
                        Job Type:
                        <span id="qJobType"></span>
                    </p>

                    <p>
                        Dimensions:
                        <span id="qDimensions"></span>
                    </p>

                    <p>
                        Doors:
                        <span id="qDoors"></span>
                    </p>

                    <p>
                        Drawers:
                        <span id="qDrawers"></span>
                    </p>

                    <p>
                        Board:
                        <span id="qBoard"></span>
                    </p>

                    <p>
                        Finish:
                        <span id="qFinish"></span>
                    </p>

                </div>

            </div>


            <table class="quote-table">

                <thead>

                    <tr>
                        <th>No.</th>
                        <th>Description</th>
                        <th>Qty</th>
                        <th>Unit</th>
                        <th>Unit Price</th>
                        <th>Total</th>
                    </tr>

                </thead>

                <tbody id="quotationItems"></tbody>

            </table>


            <div class="summary">

                <div class="summary-row">
                    <span>Materials</span>
                    <strong id="qMaterials"></strong>
                </div>

                <div class="summary-row">
                    <span>Labour</span>
                    <strong id="qLabour"></strong>
                </div>

                <div class="summary-row">
                    <span>Transport</span>
                    <strong id="qTransport"></strong>
                </div>

                <div class="summary-row">
                    <span>Other Costs</span>
                    <strong id="qOther"></strong>
                </div>

                <div class="summary-row">
                    <span>Discount</span>
                    <strong id="qDiscount"></strong>
                </div>

                <div class="summary-row">
                    <span>VAT</span>
                    <strong id="qVat"></strong>
                </div>

                <div class="summary-row summary-total">
                    <span>GRAND TOTAL</span>
                    <strong id="qGrand"></strong>
                </div>

            </div>


            <div class="validity">

                <strong>Quotation Validity:</strong>

                This quotation is valid until
                <strong id="qValidUntil"></strong>.

                <span id="qStatus"></span>

            </div>


            <div class="notes">

                <strong>Notes:</strong>

                <p>
                    This quotation is prepared based on the project
                    information and materials selected by the client.
                    Any changes to the project requirements may result
                    in a revised quotation.
                </p>

            </div>


            <div class="signature-area">

                <div class="signature">
                    Prepared by — Prime Fit Interiors
                </div>

                <div class="signature">
                    Client Approval / Signature
                </div>

            </div>


            <div class="footer">
                Prime Fit Interiors — Professional Interior Design & Furniture Solutions
            </div>

        </article>

    </div>

</section>


<script>

/* =========================================================
   DATA
   ========================================================= */

let materials = [];

const prices = {
    "18mm MDF": 4500,
    "18mm Plywood": 5000,
    "Timber": 3500,
    "Edge Banding": 80,
    "Hinges": 180,
    "Handles": 350,
    "Drawer Runners": 850,
    "Screws": 800,
    "Wood Glue": 450
};


/* =========================================================
   HELPERS
   ========================================================= */

function money(value){

    return "KES " + Number(value || 0).toLocaleString(
        "en-KE",
        {
            minimumFractionDigits:2,
            maximumFractionDigits:2
        }
    );

}


function number(value){

    return Number(value) || 0;

}


function escapeHTML(value){

    return String(value ?? "")
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


/* =========================================================
   MATERIAL CALCULATION
   ========================================================= */

function createAutomaticMaterials(){

    const width = number(document.getElementById("width").value);
    const height = number(document.getElementById("height").value);
    const depth = number(document.getElementById("depth").value);

    const doors = number(document.getElementById("doors").value);
    const drawers = number(document.getElementById("drawers").value);

    const board = document.getElementById("board").value;

    const boardQty =
        Math.max(
            1,
            Math.ceil((width * height) / 2800000)
        );

    const edgeQty =
        Math.max(
            1,
            Math.ceil(
                (
                    (width * 2) +
                    (height * 2) +
                    (depth * 2)
                ) / 1000
            )
        );

    const hingeQty = doors * 3;
    const handleQty = doors;
    const runnerQty = drawers;

    materials = [

        {
            name: board === "MDF"
                ? "18mm MDF"
                : board === "Plywood"
                    ? "18mm Plywood"
                    : "Timber",
            qty: boardQty,
            unit: "sheet",
            price: prices[
                board === "MDF"
                    ? "18mm MDF"
                    : board === "Plywood"
                        ? "18mm Plywood"
                        : "Timber"
            ]
        },

        {
            name:"Edge Banding",
            qty:edgeQty,
            unit:"m",
            price:80
        },

        {
            name:"Hinges",
            qty:hingeQty,
            unit:"pcs",
            price:180
        },

        {
            name:"Handles",
            qty:handleQty,
            unit:"pcs",
            price:350
        },

        {
            name:"Drawer Runners",
            qty:runnerQty,
            unit:"pair",
            price:850
        },

        {
            name:"Screws",
            qty:1,
            unit:"box",
            price:800
        },

        {
            name:"Wood Glue",
            qty:2,
            unit:"litres",
            price:450
        }

    ];

    renderMaterials();

}


function renderMaterials(){

    const body =
        document.getElementById("materialsBody");

    body.innerHTML = "";

    materials.forEach((item,index)=>{

        const total =
            number(item.qty) *
            number(item.price);

        const row =
            document.createElement("tr");

        row.innerHTML = `

            <td>
                <input
                    value="${escapeHTML(item.name)}"
                    oninput="updateMaterial(${index},'name',this.value)"
                >
            </td>

            <td>
                <input
                    type="number"
                    min="0"
                    value="${item.qty}"
                    oninput="updateMaterial(${index},'qty',this.value)"
                >
            </td>

            <td>
                <input
                    value="${escapeHTML(item.unit)}"
                    oninput="updateMaterial(${index},'unit',this.value)"
                >
            </td>

            <td>
                <input
                    type="number"
                    min="0"
                    value="${item.price}"
                    oninput="updateMaterial(${index},'price',this.value)"
                >
            </td>

            <td>
                <strong>${money(total)}</strong>
            </td>

            <td>
                <button
                    class="remove-btn"
                    onclick="removeMaterial(${index})"
                >
                    X
                </button>
            </td>

        `;

        body.appendChild(row);

    });

    updateTotals();

}


function updateMaterial(index,field,value){

    materials[index][field] =
        field === "qty" || field === "price"
            ? number(value)
            : value;

    renderMaterials();

}


function removeMaterial(index){

    materials.splice(index,1);

    renderMaterials();

}


function addMaterial(){

    materials.push({

        name:"New Material",
        qty:1,
        unit:"pcs",
        price:0

    });

    renderMaterials();

}


/* =========================================================
   TOTALS
   ========================================================= */

function calculateTotals(){

    const materialsTotal =
        materials.reduce(
            (sum,item)=>
                sum +
                number(item.qty) *
                number(item.price),
            0
        );

    const labour =
        number(document.getElementById("labour").value);

    const transport =
        number(document.getElementById("transport").value);

    const other =
        number(document.getElementById("otherCost").value);

    const discount =
        number(document.getElementById("discount").value);

    const vatRate =
        number(document.getElementById("vat").value);

    const beforeVat =
        materialsTotal +
        labour +
        transport +
        other -
        discount;

    const vatAmount =
        Math.max(0,beforeVat) *
        vatRate / 100;

    const grand =
        Math.max(0,beforeVat) +
        vatAmount;

    return {
        materialsTotal,
        labour,
        transport,
        other,
        discount,
        vatRate,
        vatAmount,
        grand
    };

}


function updateTotals(){

    const t = calculateTotals();

    document.getElementById("previewMaterials").textContent =
        money(t.materialsTotal);

    document.getElementById("previewLabour").textContent =
        money(t.labour);

    document.getElementById("previewTransport").textContent =
        money(t.transport);

    document.getElementById("previewOther").textContent =
        money(t.other);

    document.getElementById("previewDiscount").textContent =
        money(t.discount);

    document.getElementById("previewVat").textContent =
        money(t.vatAmount);

    document.getElementById("previewGrand").textContent =
        money(t.grand);

}


/* =========================================================
   QUOTATION NUMBER
   ========================================================= */

function createQuotationNumber(){

    const date = new Date();

    const y =
        date.getFullYear();

    const m =
        String(date.getMonth()+1)
        .padStart(2,"0");

    const d =
        String(date.getDate())
        .padStart(2,"0");

    const serial =
        String(
            Math.floor(
                1000 +
                Math.random()*9000
            )
        );

    return `PF-${y}${m}${d}-${serial}`;

}


/* =========================================================
   COLLECT DATA
   ========================================================= */

function collectQuotation(){

    const today = new Date();

    const validDays =
        number(
            document.getElementById("validDays").value
        ) || 30;

    const validUntil =
        new Date(today);

    validUntil.setDate(
        validUntil.getDate() + validDays
    );

    return {

        quotationNumber:
            createQuotationNumber(),

        date:
            today.toLocaleDateString("en-KE"),

        validUntil:
            validUntil.toLocaleDateString("en-KE"),

        validUntilISO:
            validUntil.toISOString(),

        customer:{
            name:
                document.getElementById("customerName").value,

            phone:
                document.getElementById("customerPhone").value,

            email:
                document.getElementById("customerEmail").value,

            kra:
                document.getElementById("customerKra").value,

            address:
                document.getElementById("customerAddress").value
        },

        project:{

            name:
                document.getElementById("projectName").value,

            jobType:
                document.getElementById("jobType").value,

            width:
                document.getElementById("width").value,

            height:
                document.getElementById("height").value,

            depth:
                document.getElementById("depth").value,

            doors:
                document.getElementById("doors").value,

            drawers:
                document.getElementById("drawers").value,

            board:
                document.getElementById("board").value,

            finish:
                document.getElementById("finish").value
        },

        materials:
            JSON.parse(
                JSON.stringify(materials)
            ),

        totals:
            calculateTotals()

    };

}


/* =========================================================
   GENERATE
   ========================================================= */

function generateQuotation(){

    const customerName =
        document.getElementById("customerName").value.trim();

    if(!customerName){

        alert("Please enter the customer name.");

        return;

    }

    const quotation =
        collectQuotation();

    /*
       The quotation data is stored separately from
       the builder screen.

       The browser then changes route to #quotation.
    */

    sessionStorage.setItem(
        "primefit_current_quotation",
        JSON.stringify(quotation)
    );

    window.location.hash = "quotation";

    showQuotation();

}


/* =========================================================
   SHOW QUOTATION
   ========================================================= */

function showQuotation(){

    const saved =
        sessionStorage.getItem(
            "primefit_current_quotation"
        );

    if(!saved){

        showBuilder();

        return;

    }

    const q =
        JSON.parse(saved);

    document.getElementById("builderScreen").style.display =
        "none";

    document.getElementById("quotationScreen").style.display =
        "block";


    document.getElementById("qNumber").textContent =
        q.quotationNumber;

    document.getElementById("qDate").textContent =
        q.date;


    document.getElementById("qCustomerName").textContent =
        q.customer.name;

    document.getElementById("qCustomerPhone").textContent =
        q.customer.phone
            ? "Phone: " + q.customer.phone
            : "";

    document.getElementById("qCustomerEmail").textContent =
        q.customer.email
            ? "Email: " + q.customer.email
            : "";

    document.getElementById("qCustomerKra").textContent =
        q.customer.kra
            ? "KRA PIN: " + q.customer.kra
            : "";

    document.getElementById("qCustomerAddress").textContent =
        q.customer.address;


    document.getElementById("qProjectName").textContent =
        q.project.name || q.project.jobType;

    document.getElementById("qJobType").textContent =
        q.project.jobType;

    document.getElementById("qDimensions").textContent =
        `${q.project.width} × ${q.project.height} × ${q.project.depth} mm`;

    document.getElementById("qDoors").textContent =
        q.project.doors;

    document.getElementById("qDrawers").textContent =
        q.project.drawers;

    document.getElementById("qBoard").textContent =
        "18mm " + q.project.board;

    document.getElementById("qFinish").textContent =
        q.project.finish || "As agreed";


    const items =
        document.getElementById("quotationItems");

    items.innerHTML = "";

    q.materials.forEach((item,index)=>{

        const total =
            number(item.qty) *
            number(item.price);

        const row =
            document.createElement("tr");

        row.innerHTML = `

            <td>${index+1}</td>

            <td>${escapeHTML(item.name)}</td>

            <td>${item.qty}</td>

            <td>${escapeHTML(item.unit)}</td>

            <td class="number">
                ${money(item.price)}
            </td>

            <td class="number">
                ${money(total)}
            </td>

        `;

        items.appendChild(row);

    });


    document.getElementById("qMaterials").textContent =
        money(q.totals.materialsTotal);

    document.getElementById("qLabour").textContent =
        money(q.totals.labour);

    document.getElementById("qTransport").textContent =
        money(q.totals.transport);

    document.getElementById("qOther").textContent =
        money(q.totals.other);

    document.getElementById("qDiscount").textContent =
        money(q.totals.discount);

    document.getElementById("qVat").textContent =
        money(q.totals.vatAmount);

    document.getElementById("qGrand").textContent =
        money(q.totals.grand);


    document.getElementById("qValidUntil").textContent =
        q.validUntil;


    const expiry =
        new Date(q.validUntilISO);

    const now =
        new Date();

    const difference =
        expiry - now;

    const daysLeft =
        Math.ceil(
            difference /
            (1000 * 60 * 60 * 24)
        );

    let status = "";

    if(daysLeft < 0){

        status =
            " STATUS: EXPIRED";

    }else if(daysLeft <= 7){

        status =
            " STATUS: EXPIRING SOON";

    }else{

        status =
            " STATUS: VALID";

    }

    document.getElementById("qStatus").textContent =
        status;

    window.scrollTo(0,0);

}


