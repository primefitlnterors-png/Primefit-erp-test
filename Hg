========================= */

function saveDraft(){

    const data =
        collectData();


    if(!data){
        return;
    }


    localStorage.setItem(
        "primefitDraft",
        JSON.stringify(data)
    );


    alert(
        "Quotation draft saved on this phone."
    );

}


/* =========================
   NEW QUOTATION
========================= */

function newQuotation(){

    if(
        !confirm(
            "Start a new quotation?"
        )
    ){

        return;

    }


    document.querySelectorAll(
        "input,textarea"
    ).forEach(element=>{

        if(
            element.type ===
            "checkbox"
        ){

            element.checked =
                false;

        }
        else{

            element.value =
                "";

        }

    });


    document.getElementById(
        "width"
    ).value = 2400;


    document.getElementById(
        "height"
    ).value = 2100;


    document.getElementById(
        "depth"
    ).value = 600;


    document.getElementById(
        "doors"
    ).value = 4;


    document.getElementById(
        "drawers"
    ).value = 3;


    document.getElementById(
        "validDays"
    ).value = 14;


    document.getElementById(
        "vatRate"
    ).value = 16;


    document.getElementById(
        "boardMaterial"
    ).value = "MDF";


    document.getElementById(
        "finish"
    ).value = "Melamine";


    materials = [];

    createMaterials();

}


/* =========================
   LIVE EVENTS
========================= */

[
    "width",
    "height",
    "depth",
    "doors",
    "drawers",
    "boardMaterial"
].forEach(id=>{

    document
        .getElementById(id)
        .addEventListener(
            "input",
            createMaterials
        );

});


[
    "labour",
    "transport",
    "other",
    "discount",
    "vat",
    "vatRate"
].forEach(id=>{

    document
        .getElementById(id)
        .addEventListener(
            "input",
            calculate
        );

});


/* =========================
