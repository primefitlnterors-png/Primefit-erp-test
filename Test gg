/* ---------- SAVE DRAFT ---------- */

function saveDraft(){

    const data = collectQuotation();

    if(!data){
        return;
    }

    localStorage.setItem(
        "primefitQuotationDraft",
        JSON.stringify(data)
    );

    alert("Quotation draft saved on this device.");

}


/* ---------- LOAD DRAFT ---------- */

function loadDraft(){

    const saved =
        localStorage.getItem(
            "primefitQuotationDraft"
        );

    if(!saved){

        alert("No saved quotation draft was found.");

        return;
    }

    try{

        const data = JSON.parse(saved);

        document.getElementById("customerName").value =
            data.customer.name || "";

        document.getElementById("customerPhone").value =
            data.customer.phone || "";

        document.getElementById("customerEmail").value =
            data.customer.email || "";

        document.getElementById("kraPin").value =
            data.customer.kra || "";

        document.getElementById("customerAddress").value =
            data.customer.address || "";

        document.getElementById("jobType").value =
            data.project.jobType || "";

        document.getElementById("projectName").value =
            data.project.name || "";

        document.getElementById("width").value =
            data.project.width || 0;

        document.getElementById("height").value =
            data.project.height || 0;

        document.getElementById("depth").value =
            data.project.depth || 0;

        document.getElementById("doors").value =
            data.project.doors || 0;

        document.getElementById("drawers").value =
            data.project.drawers || 0;

        document.getElementById("boardMaterial").value =
            data.project.board || "MDF";

        document.getElementById("finish").value =
            data.project.finish || "Melamine";

        materials =
            data.materials || [];

        renderMaterials();

        document.getElementById("labour").value =
            data.totals.labour || 0;

        document.getElementById("transport").value =
            data.totals.transport || 0;

        document.getElementById("otherCosts").value =
            data.totals.other || 0;

        document.getElementById("discount").value =
            data.totals.discount || 0;

        document.getElementById("vatEnabled").checked =
            data.vatEnabled || false;

        document.getElementById("vatRate").value =
            data.vatRate || 16;

        updateTotals();

        alert("Quotation draft loaded.");

    }
    catch(error){

        alert(
            "The saved quotation could not be loaded."
        );

    }

}


/* ---------- NEW QUOTATION ---------- */

function newQuotation(){

    if(
        !confirm(
            "Start a new quotation? Unsaved information will be cleared."
        )
    ){
        return;
    }

    document.querySelectorAll("input, textarea")
        .forEach(element=>{

            if(element.type === "checkbox"){
                element.checked = false;
            }
            else{
                element.value = "";
            }

        });

    document.getElementById("width").value = 3000;
    document.getElementById("height").value = 2400;
    document.getElementById("depth").value = 600;
    document.getElementById("doors").value = 4;
    document.getElementById("drawers").value = 0;
    document.getElementById("validityDays").value = 14;
    document.getElementById("vatRate").value = 16;

    document.getElementById("boardMaterial").value = "MDF";
    document.getElementById("finish").value = "Melamine";
    document.getElementById("jobType").value = "";

    materials = [];

    generateMaterials();

}


/* ---------- LIVE UPDATE EVENTS ---------- */

[
    "width",
    "height",
    "depth",
    "doors",
    "drawers",
    "boardMaterial",
    "labour",
    "transport",
    "otherCosts",
    "discount",
    "vatEnabled",
    "vatRate"
].forEach(id=>{

    document.getElementById(id)
        .addEventListener("input",function(){

            if(
                [
                    "width",
                    "height",
                    "depth",
                    "doors",
                    "drawers",
                    "boardMaterial"
                ].includes(id)
            ){

                generateMaterials();

            }
            else{

                updateTotals();

            }

        });

});


/* ---------- INITIAL MATERIALS ---------- */

generateMaterials();

